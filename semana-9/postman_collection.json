            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\",\n  \"roles\": [\"ADMIN\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/signup",
